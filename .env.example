# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/accounting_myl?schema=public"

# -----------------------------------------------------------------------------
# Auth.js / NextAuth v5
# -----------------------------------------------------------------------------
# Required. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# Public origin of the app (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"
# Optional: NextAuth v5 reads AUTH_SECRET first. If your host only allows one
# secret variable, either name works — set them to the same value.
# AUTH_SECRET="replace-with-the-same-value"
# AUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# SMTP (optional — used only for password-reset OTP delivery)
# Leave blank to use the development stub (OTP is logged to the server console).
# -----------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
